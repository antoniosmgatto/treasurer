# Local development against the Postgres in docker-compose.yml.
#
#   docker compose up -d
#   cp .env.example .env.local
#   set -a; source .env.local; set +a
#
# Leave DATABASE_URL unset instead and everything falls back to PGlite in .data/ — no install
# required, but single-writer, so the dev server and the CLI cannot both use it at once.
#
# These credentials are local-only and match docker-compose.yml. Production reads DATABASE_URL
# from the host and it is never committed.
DATABASE_URL=postgres://treasurer:treasurer@localhost:5433/treasurer_dev

# D34: the panel's gate. Leaving this unset is the point locally — no variable, no gate, and
# `next dev` stays a door you walk through rather than a login screen. It is set on the
# deployment, and setting it there is the only thing that turns the gate on.
#
# Setting it under `next start` over plain http gives a `secure` cookie the browser drops, and
# /entrar loops. Pick four random words, not base64 — somebody types this on a phone.
# PANEL_PASSPHRASE=
